<Window x:Class="CanastaNET.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="CanastaNET Desktop"
        Height="940"
        Width="1480"
        MinHeight="760"
        MinWidth="1240"
        WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding StartMatchCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveMatchCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding LoadMatchCommand}" />
        <KeyBinding Key="D" Modifiers="Control" Command="{Binding DrawStockCommand}" />
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding ApplySetupPresetCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <sys:Double x:Key="TopSeatCardLaneHeight">168</sys:Double>
        <sys:Double x:Key="StockPileWidth">102</sys:Double>
        <sys:Double x:Key="StockPileHeight">154</sys:Double>
        <GridLength x:Key="CentralPileSpacerWidth">20</GridLength>
        <GridLength x:Key="SideSeatColumnWidth">220</GridLength>
        <Thickness x:Key="DefaultHorizontalHandOverlapMargin">0,0,-84,0</Thickness>
        <Thickness x:Key="CompactHorizontalHandOverlapMargin">0,0,-92,0</Thickness>
        <Thickness x:Key="DefaultVerticalHandOverlapMargin">0,0,0,-132</Thickness>
        <Thickness x:Key="CompactVerticalHandOverlapMargin">0,0,0,-140</Thickness>
        <Thickness x:Key="VerticalHandScrollPadding">0,0,0,76</Thickness>
        <Thickness x:Key="TopSeatMargin">14,6,14,8</Thickness>
        <Thickness x:Key="BottomSeatMargin">14,8,14,0</Thickness>

        <Style x:Key="FadeInBorderStyle" TargetType="Border">
            <Setter Property="Opacity" Value="0" />
            <Style.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0"
                                             To="1"
                                             Duration="0:0:0.18" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <DropShadowEffect x:Key="CardShadowEffect"
                          BlurRadius="12"
                          ShadowDepth="4"
                          Direction="265"
                          Opacity="0.22"
                          Color="#B0000000" />

        <Style x:Key="CardShellStyle" TargetType="Border">
            <Setter Property="Width" Value="102" />
            <Setter Property="Height" Value="154" />
            <Setter Property="Margin" Value="0,0,4,4" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="1.4" />
            <Setter Property="Effect" Value="{StaticResource CardShadowEffect}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.UseCompactCardSpacing, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Margin" Value="0,0,2,2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SeatPanelStyle" TargetType="Border">
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style x:Key="OverlappedHorizontalHandItemStyle" TargetType="ContentPresenter">
            <Setter Property="Margin" Value="{DynamicResource DefaultHorizontalHandOverlapMargin}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.UseCompactCardSpacing, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Margin" Value="{DynamicResource CompactHorizontalHandOverlapMargin}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OverlappedVerticalHandItemStyle" TargetType="ContentPresenter">
            <Setter Property="Margin" Value="{DynamicResource DefaultVerticalHandOverlapMargin}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.UseCompactCardSpacing, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Margin" Value="{DynamicResource CompactVerticalHandOverlapMargin}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="DisplayCardTemplate">
            <Border Background="{Binding SurfaceColor}"
                    BorderBrush="{Binding AccentColor}"
                    Style="{StaticResource CardShellStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="6" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="{Binding AccentColor}"
                            CornerRadius="10,10,0,0" />
                    <Grid Grid.Row="1" Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <StackPanel>
                                <TextBlock FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="{Binding AccentColor}"
                                           Text="{Binding RankText}" />
                                <TextBlock Margin="0,-4,0,0"
                                           FontSize="16"
                                           Foreground="{Binding AccentColor}"
                                           Text="{Binding SuitSymbol}" />
                            </StackPanel>
                            <Border HorizontalAlignment="Right"
                                    Padding="7,2"
                                    Background="{Binding AccentColor}"
                                    CornerRadius="8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.ShowCardPointBadges, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           Text="{Binding PointBadgeText}" />
                            </Border>
                        </Grid>

                        <StackPanel Grid.Row="1"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                            <Border Padding="9,4"
                                    Margin="0,6,0,10"
                                    Background="#12000000"
                                    CornerRadius="8">
                                <TextBlock FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding AccentColor}"
                                           Text="{Binding CardTypeLabel}" />
                            </Border>
                            <TextBlock HorizontalAlignment="Center"
                                       FontSize="40"
                                       Foreground="{Binding AccentColor}"
                                       Text="{Binding SuitSymbol}" />
                            <TextBlock Margin="0,6,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="12"
                                       Foreground="#7A17212B"
                                       Text="{Binding SuitText}" />
                        </StackPanel>

                        <Grid Grid.Row="2">
                            <TextBlock VerticalAlignment="Bottom"
                                       FontSize="10"
                                       Foreground="#9917212B"
                                       Text="{Binding DisplayText}"
                                       TextWrapping="Wrap" />
                            <Border HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Padding="7,2"
                                    Background="#1217212B"
                                    CornerRadius="8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.ShowDeckRibbons, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="9"
                                           FontWeight="SemiBold"
                                           Foreground="#CC17212B"
                                           Text="{Binding DeckLabel}" />
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PlayableCardTemplate">
            <Border Background="{Binding SurfaceColor}"
                    BorderBrush="{Binding AccentColor}">
                <Border.Style>
                    <Style BasedOn="{StaticResource CardShellStyle}" TargetType="Border">
                        <Setter Property="Background" Value="{Binding SurfaceColor}" />
                        <Setter Property="BorderBrush" Value="{Binding AccentColor}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource ActionBrush}" />
                                <Setter Property="BorderThickness" Value="3" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="6" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="{Binding AccentColor}"
                            CornerRadius="10,10,0,0" />
                    <Grid Grid.Row="1" Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <StackPanel>
                                <TextBlock FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="{Binding AccentColor}"
                                           Text="{Binding RankText}" />
                                <TextBlock Margin="0,-4,0,0"
                                           FontSize="16"
                                           Foreground="{Binding AccentColor}"
                                           Text="{Binding SuitSymbol}" />
                            </StackPanel>
                            <Border HorizontalAlignment="Right"
                                    Padding="7,2"
                                    Background="{Binding AccentColor}"
                                    CornerRadius="8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.ShowCardPointBadges, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           Text="{Binding PointValue, StringFormat={}{0} pts}" />
                            </Border>
                        </Grid>

                        <StackPanel Grid.Row="1"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                            <CheckBox Margin="0,0,0,8"
                                      HorizontalAlignment="Center"
                                      Content="Ready"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      IsEnabled="{Binding CanSelect}" />
                            <TextBlock HorizontalAlignment="Center"
                                       FontSize="40"
                                       Foreground="{Binding AccentColor}"
                                       Text="{Binding SuitSymbol}" />
                            <TextBlock Margin="0,6,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding AccentColor}"
                                       Text="{Binding CardTypeLabel}" />
                        </StackPanel>

                        <Grid Grid.Row="2">
                            <TextBlock VerticalAlignment="Bottom"
                                       FontSize="10"
                                       Foreground="#9917212B"
                                       Text="{Binding DisplayText}"
                                       TextWrapping="Wrap" />
                            <Border HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Padding="7,2"
                                    Background="#1217212B"
                                    CornerRadius="8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.ShowDeckRibbons, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="9"
                                           FontWeight="SemiBold"
                                           Foreground="#CC17212B"
                                           Text="{Binding DeckLabel}" />
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New match" Command="{Binding StartMatchCommand}" InputGestureText="Ctrl+N" />
                <Separator />
                <MenuItem Header="_Save snapshot" Command="{Binding SaveMatchCommand}" InputGestureText="Ctrl+S" />
                <MenuItem Header="_Load snapshot" Command="{Binding LoadMatchCommand}" InputGestureText="Ctrl+O" />
                <MenuItem Header="Load _recent snapshot" Command="{Binding LoadRecentMatchCommand}" />
            </MenuItem>
            <MenuItem Header="_Match">
                <MenuItem Header="Start _classic four-player table"
                          Tag="Classic 4-player table"
                          Click="StartPreset_Click" />
                <MenuItem Header="Start _quick duo practice"
                          Tag="Quick duo practice"
                          Click="StartPreset_Click" />
                <MenuItem Header="Start _long match rematch"
                          Tag="Long match rematch"
                          Click="StartPreset_Click" />
                <Separator />
                <MenuItem Header="_Next round"
                          Command="{Binding NextRoundCommand}"
                          Visibility="{Binding ShowNextRoundAction, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </MenuItem>
            <MenuItem Header="_Settings">
                <MenuItem Header="Show point _badges"
                          IsCheckable="True"
                          IsChecked="{Binding ShowCardPointBadges, Mode=TwoWay}" />
                <MenuItem Header="Show deck _ribbons"
                          IsCheckable="True"
                          IsChecked="{Binding ShowDeckRibbons, Mode=TwoWay}" />
                <MenuItem Header="_Compact card spacing"
                          IsCheckable="True"
                          IsChecked="{Binding UseCompactCardSpacing, Mode=TwoWay}" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="Open _quick rules help"
                          Click="ShowRulesHelp_Click" />
                <Separator />
                <MenuItem Header="Ctrl+N new match" IsEnabled="False" />
                <MenuItem Header="Ctrl+S save snapshot" IsEnabled="False" />
                <MenuItem Header="Ctrl+O load snapshot" IsEnabled="False" />
                <MenuItem Header="Ctrl+D draw stock" IsEnabled="False" />
            </MenuItem>
        </Menu>

        <Grid Margin="16">
            <Border Background="#FF1F5B47"
                    BorderBrush="#4CFFFFFF"
                    BorderThickness="1"
                    CornerRadius="32" />

            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{DynamicResource SideSeatColumnWidth}" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="{DynamicResource SideSeatColumnWidth}" />
                </Grid.ColumnDefinitions>

                 <Border Grid.Row="0"
                         Grid.Column="2"
                         Margin="{DynamicResource TopSeatMargin}">
                    <Border.Style>
                        <Style BasedOn="{StaticResource SeatPanelStyle}" TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TopSeatHand}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                     </Border.Style>
                     <StackPanel>
                         <TextBlock Margin="10,0,0,6"
                                    FontSize="12"
                                    Foreground="{StaticResource MutedTextBrush}"
                                    Text="{Binding TopSeatHand.Name}" />
                         <ItemsControl ItemsSource="{Binding TopSeatHand.Cards}"
                                       HorizontalAlignment="Center"
                                       ItemContainerStyle="{StaticResource OverlappedHorizontalHandItemStyle}"
                                         Margin="0,0,0,4">
                              <ItemsControl.ItemsPanel>
                                   <ItemsPanelTemplate>
                                       <WrapPanel Orientation="Horizontal" />
                                   </ItemsPanelTemplate>
                               </ItemsControl.ItemsPanel>
                               <ItemsControl.ItemTemplate>
                                  <StaticResource ResourceKey="PlayableCardTemplate" />
                              </ItemsControl.ItemTemplate>
                          </ItemsControl>
                     </StackPanel>
                 </Border>

                <Border Grid.Row="0"
                        Grid.RowSpan="3"
                        Grid.Column="0">
                    <Border.Style>
                        <Style BasedOn="{StaticResource SeatPanelStyle}" TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LeftSeatHand}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid Margin="0,0,10,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                         <TextBlock Margin="0,0,0,6"
                                    FontSize="12"
                                    Foreground="{StaticResource MutedTextBrush}"
                                    Text="{Binding LeftSeatHand.Name}" />
                          <ItemsControl Grid.Row="1"
                                        ItemContainerStyle="{StaticResource OverlappedVerticalHandItemStyle}"
                                         Margin="0,4,0,0"
                                         ItemsSource="{Binding LeftSeatHand.Cards}">
                               <ItemsControl.ItemsPanel>
                                   <ItemsPanelTemplate>
                                       <WrapPanel Orientation="Vertical" />
                                   </ItemsPanelTemplate>
                               </ItemsControl.ItemsPanel>
                               <ItemsControl.ItemTemplate>
                                  <StaticResource ResourceKey="PlayableCardTemplate" />
                              </ItemsControl.ItemTemplate>
                          </ItemsControl>
                     </Grid>
                 </Border>

                 <Border Grid.Row="1"
                         Grid.Column="2"
                         Padding="18"
                         Background="#1A17212B"
                         BorderBrush="#33FFFFFF"
                         BorderThickness="0"
                         CornerRadius="24"
                         Style="{StaticResource FadeInBorderStyle}">
                     <Grid HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                         <Grid.ColumnDefinitions>
                             <ColumnDefinition Width="Auto" />
                             <ColumnDefinition Width="{StaticResource CentralPileSpacerWidth}" />
                             <ColumnDefinition Width="Auto" />
                         </Grid.ColumnDefinitions>

                         <Grid Width="{StaticResource StockPileWidth}"
                               Height="{StaticResource StockPileHeight}"
                               automation:AutomationProperties.Name="Stock pile"
                               automation:AutomationProperties.HelpText="Face-down draw pile.">
                             <Border Margin="16,16,0,0"
                                     Background="#1EFFFFFF"
                                     BorderBrush="#2FFFFFFF"
                                     BorderThickness="1"
                                     CornerRadius="14" />
                             <Border Margin="8,8,0,0"
                                     Background="#2A1C3044"
                                     BorderBrush="#35FFFFFF"
                                     BorderThickness="1"
                                     CornerRadius="14" />
                             <Border Background="#FFF7FBFF"
                                     BorderBrush="#FF4F9DED"
                                     BorderThickness="1.4"
                                     CornerRadius="14"
                                     Effect="{StaticResource CardShadowEffect}">
                                 <Grid>
                                     <Border Margin="20"
                                             Background="#154F9DED"
                                             CornerRadius="10"
                                             automation:AutomationProperties.Name="" />
                                     <UniformGrid Rows="2"
                                                  Columns="2"
                                                  automation:AutomationProperties.Name=""
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center">
                                         <TextBlock Margin="0,0,6,6"
                                                    FontSize="18"
                                                    Foreground="#A64F9DED"
                                                    Text="♠" />
                                         <TextBlock Margin="6,0,0,6"
                                                    FontSize="18"
                                                    Foreground="#A64F9DED"
                                                    Text="♥" />
                                         <TextBlock Margin="0,6,6,0"
                                                    FontSize="18"
                                                    Foreground="#A64F9DED"
                                                    Text="♣" />
                                         <TextBlock Margin="6,6,0,0"
                                                    FontSize="18"
                                                    Foreground="#A64F9DED"
                                                    Text="♦" />
                                     </UniformGrid>
                                 </Grid>
                             </Border>
                         </Grid>

                         <Grid Grid.Column="2"
                               Width="{StaticResource StockPileWidth}"
                               Height="{StaticResource StockPileHeight}">
                             <ContentPresenter HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Content="{Binding DiscardPile.TopCardVisual}"
                                               ContentTemplate="{StaticResource DisplayCardTemplate}"
                                               automation:AutomationProperties.Name="Discard pile" />
                         </Grid>
                     </Grid>
                 </Border>

                <Border Grid.Row="0"
                        Grid.RowSpan="3"
                        Grid.Column="4">
                    <Border.Style>
                        <Style BasedOn="{StaticResource SeatPanelStyle}" TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RightSeatHand}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid Margin="10,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                         <TextBlock Margin="0,0,0,6"
                                    FontSize="12"
                                    Foreground="{StaticResource MutedTextBrush}"
                                    Text="{Binding RightSeatHand.Name}" />
                          <ItemsControl Grid.Row="1"
                                        ItemContainerStyle="{StaticResource OverlappedVerticalHandItemStyle}"
                                         Margin="0,4,0,0"
                                         ItemsSource="{Binding RightSeatHand.Cards}">
                               <ItemsControl.ItemsPanel>
                                   <ItemsPanelTemplate>
                                       <WrapPanel Orientation="Vertical" />
                                   </ItemsPanelTemplate>
                               </ItemsControl.ItemsPanel>
                               <ItemsControl.ItemTemplate>
                                  <StaticResource ResourceKey="PlayableCardTemplate" />
                              </ItemsControl.ItemTemplate>
                          </ItemsControl>
                     </Grid>
                 </Border>

                <Border Grid.Row="2"
                        Grid.Column="2"
                        Margin="{DynamicResource BottomSeatMargin}">
                    <Border.Style>
                        <Style BasedOn="{StaticResource SeatPanelStyle}" TargetType="Border" />
                    </Border.Style>
                     <StackPanel>
                         <TextBlock Margin="10,0,0,6"
                                    FontSize="12"
                                    Foreground="{StaticResource MutedTextBrush}"
                                    Text="{Binding BottomSeatHand.Name, TargetNullValue=No active hand}" />
                         <Border Margin="0,0,0,10"
                                 Padding="14"
                                 Background="#1AFFFFFF"
                                 BorderBrush="#1FFFFFFF"
                                 BorderThickness="1"
                                 CornerRadius="18"
                                 Visibility="{Binding ShowNextActionPrompt, Converter={StaticResource BooleanToVisibilityConverter}}">
                             <TextBlock Text="{Binding NextActionPrompt}"
                                        TextWrapping="Wrap"
                                        automation:AutomationProperties.Name="Next action prompt"
                                        automation:AutomationProperties.HelpText="Suggested next legal action for the current table state." />
                         </Border>
                         <Border Margin="0,0,0,10"
                                 Padding="12"
                                 Background="{StaticResource SuccessBrush}"
                                 CornerRadius="14"
                                 Style="{StaticResource FadeInBorderStyle}">
                             <TextBlock Text="{Binding FeedbackMessage, TargetNullValue=Desktop workspace ready.}"
                                        TextWrapping="Wrap"
                                        automation:AutomationProperties.HelpText="Latest feedback from the workspace." />
                         </Border>
                         <StackPanel Margin="0,0,0,10"
                                     Visibility="{Binding ShowRoundActions, Converter={StaticResource BooleanToVisibilityConverter}}">
                             <ComboBox Margin="0,0,0,8"
                                       ItemsSource="{Binding AvailableMeldRanks}"
                                       SelectedItem="{Binding SelectedMeldRankName, UpdateSourceTrigger=PropertyChanged}"
                                       Visibility="{Binding ShowMeldAction, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       automation:AutomationProperties.Name="Meld rank selector" />
                             <WrapPanel>
                                 <Button Command="{Binding DrawStockCommand}"
                                         Content="_Draw stock"
                                         Visibility="{Binding ShowDrawActions, Converter={StaticResource BooleanToVisibilityConverter}}"
                                         automation:AutomationProperties.Name="Draw from the stock pile" />
                                 <Button Command="{Binding DrawDiscardCommand}"
                                         Content="Draw _discard"
                                         Visibility="{Binding ShowDrawActions, Converter={StaticResource BooleanToVisibilityConverter}}"
                                         automation:AutomationProperties.Name="Draw from the discard pile" />
                                 <Button Command="{Binding MeldCommand}"
                                         Content="_Meld selected"
                                         Visibility="{Binding ShowMeldAction, Converter={StaticResource BooleanToVisibilityConverter}}"
                                         automation:AutomationProperties.Name="Meld the selected cards" />
                                 <Button Command="{Binding DiscardCommand}"
                                         Content="D_iscard selected"
                                         Visibility="{Binding ShowDiscardActions, Converter={StaticResource BooleanToVisibilityConverter}}"
                                         automation:AutomationProperties.Name="Discard the selected card" />
                                 <Button Command="{Binding EndTurnCommand}"
                                         Content="_End turn"
                                         Visibility="{Binding ShowDiscardActions, Converter={StaticResource BooleanToVisibilityConverter}}"
                                         automation:AutomationProperties.Name="End the turn by discarding the selected card" />
                                 <Button Command="{Binding NextRoundCommand}"
                                         Content="_Next round"
                                         Visibility="{Binding ShowNextRoundAction, Converter={StaticResource BooleanToVisibilityConverter}}"
                                         automation:AutomationProperties.Name="Start the next round" />
                             </WrapPanel>
                         </StackPanel>
                           <ItemsControl ItemsSource="{Binding BottomSeatHand.Cards}"
                                         HorizontalAlignment="Center"
                                         ItemContainerStyle="{StaticResource OverlappedHorizontalHandItemStyle}">
                               <ItemsControl.ItemsPanel>
                                   <ItemsPanelTemplate>
                                       <WrapPanel Orientation="Horizontal" />
                                   </ItemsPanelTemplate>
                               </ItemsControl.ItemsPanel>
                               <ItemsControl.ItemTemplate>
                                  <StaticResource ResourceKey="PlayableCardTemplate" />
                              </ItemsControl.ItemTemplate>
                         </ItemsControl>
                     </StackPanel>
                 </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
