<Window x:Class="CanastaNET.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="CanastaNET Desktop"
        Height="900"
        Width="1400"
        MinHeight="720"
        MinWidth="1200">
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding StartMatchCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveMatchCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding LoadMatchCommand}" />
        <KeyBinding Key="D" Modifiers="Control" Command="{Binding DrawStockCommand}" />
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding ApplySetupPresetCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <Style x:Key="FadeInBorderStyle" TargetType="Border">
            <Setter Property="Opacity" Value="0" />
            <Style.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0"
                                             To="1"
                                             Duration="0:0:0.18" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock FontSize="28"
                           FontWeight="SemiBold"
                           Text="CanastaNET desktop shell" />
                <TextBlock Margin="0,4,0,16"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="Milestone 7 polish: onboarding presets, legal-next-action prompts, save/load snapshots, recent history, keyboard shortcuts, and accessibility-minded table views." />

                <Border Padding="12"
                        Margin="0,0,0,12"
                        Background="{StaticResource SuccessBrush}"
                        CornerRadius="6"
                        Style="{StaticResource FadeInBorderStyle}">
                    <TextBlock Text="{Binding FeedbackMessage, TargetNullValue=Ready for manual play validation.}"
                               TextWrapping="Wrap"
                               automation:AutomationProperties.HelpText="Latest feedback from the workspace." />
                </Border>

                <GroupBox Header="Onboarding">
                    <StackPanel>
                        <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Setup preset" />
                        <ComboBox ItemsSource="{Binding SetupPresets}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Name"
                                  SelectedValue="{Binding SelectedSetupPresetName, UpdateSourceTrigger=PropertyChanged}"
                                  Margin="0,0,0,8"
                                  automation:AutomationProperties.Name="Setup preset selector" />
                        <TextBlock Foreground="{StaticResource MutedTextBrush}"
                                   Text="{Binding SelectedSetupPresetDescription}"
                                   TextWrapping="Wrap" />
                        <Button Command="{Binding ApplySetupPresetCommand}"
                                Content="_Apply preset"
                                automation:AutomationProperties.Name="Apply selected setup preset" />

                        <TextBlock Margin="0,8,0,0"
                                   FontWeight="SemiBold"
                                   Text="Suggested next action" />
                        <TextBlock Foreground="{StaticResource MutedTextBrush}"
                                   Text="{Binding NextActionPrompt}"
                                   TextWrapping="Wrap"
                                   automation:AutomationProperties.HelpText="Suggested next legal action for the current table state." />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Setup flow">
                    <StackPanel>
                        <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Players (comma separated)" />
                        <TextBox Text="{Binding Setup.PlayerNamesCsv, UpdateSourceTrigger=PropertyChanged}"
                                 automation:AutomationProperties.Name="Player names" />

                        <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Team count" />
                        <TextBox Text="{Binding Setup.TeamCount, UpdateSourceTrigger=PropertyChanged}"
                                 automation:AutomationProperties.Name="Team count" />

                        <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Dealer index" />
                        <TextBox Text="{Binding Setup.DealerIndex, UpdateSourceTrigger=PropertyChanged}"
                                 automation:AutomationProperties.Name="Dealer index" />

                        <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Deck count" />
                        <TextBox Text="{Binding Setup.DeckCount, UpdateSourceTrigger=PropertyChanged}"
                                 automation:AutomationProperties.Name="Deck count" />

                        <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Cards per player" />
                        <TextBox Text="{Binding Setup.CardsPerPlayer, UpdateSourceTrigger=PropertyChanged}"
                                 automation:AutomationProperties.Name="Cards per player" />

                        <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Winning score" />
                        <TextBox Text="{Binding Setup.WinningScore, UpdateSourceTrigger=PropertyChanged}"
                                 automation:AutomationProperties.Name="Winning score" />

                        <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Opening seed (optional)" />
                        <TextBox Text="{Binding Setup.SeedText, UpdateSourceTrigger=PropertyChanged}"
                                 automation:AutomationProperties.Name="Opening seed" />

                        <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Next-round seed (optional)" />
                        <TextBox Text="{Binding Setup.NextRoundSeedText, UpdateSourceTrigger=PropertyChanged}"
                                 automation:AutomationProperties.Name="Next round seed" />

                        <Button Command="{Binding StartMatchCommand}"
                                Content="_Start match"
                                automation:AutomationProperties.Name="Start a new match" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Round actions">
                    <WrapPanel>
                        <Button Command="{Binding DrawStockCommand}"
                                Content="_Draw stock"
                                automation:AutomationProperties.Name="Draw from the stock pile" />
                        <Button Command="{Binding DrawDiscardCommand}"
                                Content="Draw _discard"
                                automation:AutomationProperties.Name="Draw from the discard pile" />
                        <Button Command="{Binding MeldCommand}"
                                Content="_Meld selected"
                                automation:AutomationProperties.Name="Meld the selected cards" />
                        <Button Command="{Binding DiscardCommand}"
                                Content="D_iscard selected"
                                automation:AutomationProperties.Name="Discard the selected card" />
                        <Button Command="{Binding EndTurnCommand}"
                                Content="_End turn"
                                automation:AutomationProperties.Name="End the turn by discarding the selected card" />
                        <Button Command="{Binding NextRoundCommand}"
                                Content="_Next round"
                                automation:AutomationProperties.Name="Start the next round" />
                    </WrapPanel>
                </GroupBox>

                <GroupBox Header="Meld options">
                    <StackPanel>
                        <TextBlock Foreground="{StaticResource MutedTextBrush}"
                                   Text="Optional target rank when the selected meld only contains wild cards." />
                        <ComboBox ItemsSource="{Binding AvailableMeldRanks}"
                                  SelectedItem="{Binding SelectedMeldRankName, UpdateSourceTrigger=PropertyChanged}"
                                  Margin="0,8,0,0" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Save or load snapshots">
                    <StackPanel>
                        <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Snapshot path" />
                        <TextBox Text="{Binding MatchFilePath, UpdateSourceTrigger=PropertyChanged}"
                                 automation:AutomationProperties.Name="Match snapshot path" />
                        <WrapPanel>
                            <Button Command="{Binding SaveMatchCommand}"
                                    Content="_Save match"
                                    automation:AutomationProperties.Name="Save the current match snapshot" />
                            <Button Command="{Binding LoadMatchCommand}"
                                    Content="_Load match"
                                    automation:AutomationProperties.Name="Load a match snapshot from disk" />
                        </WrapPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Recent match history">
                    <StackPanel>
                        <TextBlock Foreground="{StaticResource MutedTextBrush}"
                                   Text="Recently saved or loaded snapshots for quick replay."
                                   TextWrapping="Wrap" />
                        <ComboBox ItemsSource="{Binding RecentMatches}"
                                  DisplayMemberPath="DisplayText"
                                  SelectedValuePath="Path"
                                  SelectedValue="{Binding SelectedRecentMatchPath, UpdateSourceTrigger=PropertyChanged}"
                                  Margin="0,8,0,8"
                                  automation:AutomationProperties.Name="Recent match history" />
                        <Button Command="{Binding LoadRecentMatchCommand}"
                                Content="Load _recent match"
                                automation:AutomationProperties.Name="Load selected recent match" />
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <TabControl Grid.Column="2"
                    Background="{StaticResource PanelBackgroundBrush}">
            <TabItem Header="Table overview">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock FontSize="24" FontWeight="SemiBold" Text="Round overview" />
                        <TextBlock Margin="0,0,0,16"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="Snapshot-driven summary of the authoritative engine state." />

                        <UniformGrid Columns="2" Margin="0,0,0,16">
                            <GroupBox Header="Current table state">
                                <StackPanel>
                                    <TextBlock Text="{Binding TableOverview.RoundNumber, StringFormat=Round {0}}" />
                                    <TextBlock Text="{Binding TableOverview.CurrentPlayerName, StringFormat=Current player: {0}}" />
                                    <TextBlock Text="{Binding TableOverview.CurrentPlayerIndex, StringFormat=Player index: {0}}" />
                                    <TextBlock Text="{Binding TableOverview.CurrentPlayerTeamIndex, StringFormat=Team index: {0}}" />
                                    <TextBlock Text="{Binding TableOverview.TurnPhase, StringFormat=Turn phase: {0}}" />
                                    <TextBlock Text="{Binding TableOverview.StockCount, StringFormat=Stock count: {0}}" />
                                    <TextBlock Text="{Binding TableOverview.DiscardTopCard, StringFormat=Discard top: {0}}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding TableOverview.CompletedTurns, StringFormat=Completed turns: {0}}" />
                                    <TextBlock Text="{Binding TableOverview.CurrentTurnMeldPoints, StringFormat=Current turn meld points: {0}}" />
                                    <TextBlock Text="{Binding TableOverview.ShuffleSeed, StringFormat=Shuffle seed: {0}}" />
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Legal action summary">
                                <ItemsControl ItemsSource="{Binding LegalCommands}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,8">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding CommandText}" />
                                                <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="{Binding Description}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </GroupBox>
                        </UniformGrid>

                        <GroupBox Header="Round completion summary">
                            <TextBlock Text="{Binding TableOverview.RoundMessage, TargetNullValue=The round is still in progress.}" TextWrapping="Wrap" />
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Player hands">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl Margin="16" ItemsSource="{Binding PlayerHands}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <GroupBox Header="{Binding Header}">
                                    <ItemsControl ItemsSource="{Binding Cards}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="220"
                                                            Margin="0,0,8,8"
                                                            Padding="8"
                                                            Background="{StaticResource PanelAccentBrush}"
                                                            CornerRadius="6"
                                                            Style="{StaticResource FadeInBorderStyle}">
                                                        <StackPanel>
                                                            <CheckBox Content="Select for commands"
                                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                      IsEnabled="{Binding CanSelect}" />
                                                            <TextBlock Margin="0,4,0,0"
                                                                   FontWeight="SemiBold"
                                                                   Text="{Binding DisplayText}"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Foreground="{StaticResource MutedTextBrush}"
                                                                   Text="{Binding PointValue, StringFormat=Point value: {0}}" />
                                                        <TextBlock Foreground="{StaticResource MutedTextBrush}"
                                                                   Text="{Binding IsWild, StringFormat=Wild card: {0}}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </GroupBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Melds">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl Margin="16" ItemsSource="{Binding TeamMelds}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <GroupBox Header="{Binding TeamIndex, StringFormat=Team {0}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Members, StringFormat=Players: {0}}" />
                                        <TextBlock Text="{Binding StartingScore, StringFormat=Starting score: {0}}" />
                                        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Melds}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,0,8"
                                                            Padding="8"
                                                            Background="{StaticResource PanelAccentBrush}"
                                                            CornerRadius="6">
                                                        <StackPanel>
                                                            <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                                            <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding Cards}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </GroupBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Discard pile">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <GroupBox Header="Discard status">
                            <StackPanel>
                                <TextBlock Text="{Binding DiscardPile.TopCard, StringFormat=Top card: {0}}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding DiscardPile.IsFrozen, StringFormat=Frozen pile: {0}}" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Pile order (top first)">
                            <ItemsControl ItemsSource="{Binding DiscardPile.Cards}" />
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Score summary">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <GroupBox Header="Match totals">
                            <StackPanel>
                                <TextBlock Text="{Binding ScoreSummary.WinningScore, StringFormat=Winning score target: {0}}" />
                                <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding ScoreSummary.TeamScores}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding SummaryText}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Completed-round summary">
                            <ItemsControl ItemsSource="{Binding ScoreSummary.RoundSummaryLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Rules help">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock FontSize="24" FontWeight="SemiBold" Text="Quick rules help" />
                        <TextBlock Margin="0,0,0,16"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="A short reminder list for onboarding and for shared-table play sessions." />

                        <ItemsControl ItemsSource="{Binding RulesHelpLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8"
                                            Padding="10"
                                            Background="{StaticResource PanelAccentBrush}"
                                            CornerRadius="6">
                                        <TextBlock Text="{Binding StringFormat=• {0}}" TextWrapping="Wrap" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
