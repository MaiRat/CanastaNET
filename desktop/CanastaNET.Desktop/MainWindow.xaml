<Window x:Class="CanastaNET.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="CanastaNET Desktop"
        Height="940"
        Width="1480"
        MinHeight="760"
        MinWidth="1240"
        WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding StartMatchCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveMatchCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding LoadMatchCommand}" />
        <KeyBinding Key="D" Modifiers="Control" Command="{Binding DrawStockCommand}" />
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding ApplySetupPresetCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <sys:Double x:Key="TopSeatCardLaneHeight">188</sys:Double>
        <sys:Double x:Key="CentralPileSpacerWidth">20</sys:Double>
        <Thickness x:Key="DefaultHorizontalHandOverlapMargin">0,0,-90,0</Thickness>
        <Thickness x:Key="CompactHorizontalHandOverlapMargin">0,0,-78,0</Thickness>
        <Thickness x:Key="DefaultVerticalHandOverlapMargin">0,0,0,-136</Thickness>
        <Thickness x:Key="CompactVerticalHandOverlapMargin">0,0,0,-120</Thickness>
        <Thickness x:Key="VerticalHandScrollPadding">0,0,0,92</Thickness>
        <Thickness x:Key="TopSeatMargin">28,10,28,16</Thickness>
        <Thickness x:Key="BottomSeatMargin">28,16,28,0</Thickness>

        <Style x:Key="FadeInBorderStyle" TargetType="Border">
            <Setter Property="Opacity" Value="0" />
            <Style.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0"
                                             To="1"
                                             Duration="0:0:0.18" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <DropShadowEffect x:Key="CardShadowEffect"
                          BlurRadius="12"
                          ShadowDepth="4"
                          Direction="265"
                          Opacity="0.22"
                          Color="#B0000000" />

        <Style x:Key="CardShellStyle" TargetType="Border">
            <Setter Property="Width" Value="108" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="1.4" />
            <Setter Property="Effect" Value="{StaticResource CardShadowEffect}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.UseCompactCardSpacing, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Width" Value="96" />
                    <Setter Property="Margin" Value="0,0,4,4" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SeatPanelStyle" TargetType="Border">
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style x:Key="OverlappedHorizontalHandItemStyle" TargetType="ContentPresenter">
            <Setter Property="Margin" Value="{StaticResource DefaultHorizontalHandOverlapMargin}" />
            <Setter Property="LayoutTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="0.86" ScaleY="0.86" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.UseCompactCardSpacing, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Margin" Value="{StaticResource CompactHorizontalHandOverlapMargin}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OverlappedVerticalHandItemStyle" TargetType="ContentPresenter">
            <Setter Property="Margin" Value="{StaticResource DefaultVerticalHandOverlapMargin}" />
            <Setter Property="LayoutTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="0.82" ScaleY="0.82" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.UseCompactCardSpacing, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Margin" Value="{StaticResource CompactVerticalHandOverlapMargin}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="DisplayCardTemplate">
            <Border Background="{Binding SurfaceColor}"
                    BorderBrush="{Binding AccentColor}"
                    Style="{StaticResource CardShellStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="6" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="{Binding AccentColor}"
                            CornerRadius="10,10,0,0" />
                    <Grid Grid.Row="1" Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <StackPanel>
                                <TextBlock FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="{Binding AccentColor}"
                                           Text="{Binding RankText}" />
                                <TextBlock Margin="0,-4,0,0"
                                           FontSize="16"
                                           Foreground="{Binding AccentColor}"
                                           Text="{Binding SuitSymbol}" />
                            </StackPanel>
                            <Border HorizontalAlignment="Right"
                                    Padding="7,2"
                                    Background="{Binding AccentColor}"
                                    CornerRadius="8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.ShowCardPointBadges, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           Text="{Binding PointBadgeText}" />
                            </Border>
                        </Grid>

                        <StackPanel Grid.Row="1"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                            <Border Padding="9,4"
                                    Margin="0,6,0,10"
                                    Background="#12000000"
                                    CornerRadius="8">
                                <TextBlock FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding AccentColor}"
                                           Text="{Binding CardTypeLabel}" />
                            </Border>
                            <TextBlock HorizontalAlignment="Center"
                                       FontSize="40"
                                       Foreground="{Binding AccentColor}"
                                       Text="{Binding SuitSymbol}" />
                            <TextBlock Margin="0,6,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="12"
                                       Foreground="#7A17212B"
                                       Text="{Binding SuitText}" />
                        </StackPanel>

                        <Grid Grid.Row="2">
                            <TextBlock VerticalAlignment="Bottom"
                                       FontSize="10"
                                       Foreground="#9917212B"
                                       Text="{Binding DisplayText}"
                                       TextWrapping="Wrap" />
                            <Border HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Padding="7,2"
                                    Background="#1217212B"
                                    CornerRadius="8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.ShowDeckRibbons, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="9"
                                           FontWeight="SemiBold"
                                           Foreground="#CC17212B"
                                           Text="{Binding DeckLabel}" />
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PlayableCardTemplate">
            <Border Background="{Binding SurfaceColor}"
                    BorderBrush="{Binding AccentColor}">
                <Border.Style>
                    <Style BasedOn="{StaticResource CardShellStyle}" TargetType="Border">
                        <Setter Property="Background" Value="{Binding SurfaceColor}" />
                        <Setter Property="BorderBrush" Value="{Binding AccentColor}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource ActionBrush}" />
                                <Setter Property="BorderThickness" Value="3" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="6" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="{Binding AccentColor}"
                            CornerRadius="10,10,0,0" />
                    <Grid Grid.Row="1" Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <StackPanel>
                                <TextBlock FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="{Binding AccentColor}"
                                           Text="{Binding RankText}" />
                                <TextBlock Margin="0,-4,0,0"
                                           FontSize="16"
                                           Foreground="{Binding AccentColor}"
                                           Text="{Binding SuitSymbol}" />
                            </StackPanel>
                            <Border HorizontalAlignment="Right"
                                    Padding="7,2"
                                    Background="{Binding AccentColor}"
                                    CornerRadius="8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.ShowCardPointBadges, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           Text="{Binding PointValue, StringFormat={}{0} pts}" />
                            </Border>
                        </Grid>

                        <StackPanel Grid.Row="1"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                            <CheckBox Margin="0,0,0,8"
                                      HorizontalAlignment="Center"
                                      Content="Ready"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      IsEnabled="{Binding CanSelect}" />
                            <TextBlock HorizontalAlignment="Center"
                                       FontSize="40"
                                       Foreground="{Binding AccentColor}"
                                       Text="{Binding SuitSymbol}" />
                            <TextBlock Margin="0,6,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding AccentColor}"
                                       Text="{Binding CardTypeLabel}" />
                        </StackPanel>

                        <Grid Grid.Row="2">
                            <TextBlock VerticalAlignment="Bottom"
                                       FontSize="10"
                                       Foreground="#9917212B"
                                       Text="{Binding DisplayText}"
                                       TextWrapping="Wrap" />
                            <Border HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Padding="7,2"
                                    Background="#1217212B"
                                    CornerRadius="8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.ShowDeckRibbons, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="9"
                                           FontWeight="SemiBold"
                                           Foreground="#CC17212B"
                                           Text="{Binding DeckLabel}" />
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New match" Command="{Binding StartMatchCommand}" InputGestureText="Ctrl+N" />
                <Separator />
                <MenuItem Header="_Save snapshot" Command="{Binding SaveMatchCommand}" InputGestureText="Ctrl+S" />
                <MenuItem Header="_Load snapshot" Command="{Binding LoadMatchCommand}" InputGestureText="Ctrl+O" />
                <MenuItem Header="Load _recent snapshot" Command="{Binding LoadRecentMatchCommand}" />
            </MenuItem>
            <MenuItem Header="_Match">
                <MenuItem Header="Start _classic four-player table"
                          Tag="Classic 4-player table"
                          Click="StartPreset_Click" />
                <MenuItem Header="Start _quick duo practice"
                          Tag="Quick duo practice"
                          Click="StartPreset_Click" />
                <MenuItem Header="Start _long match rematch"
                          Tag="Long match rematch"
                          Click="StartPreset_Click" />
                <Separator />
                <MenuItem Header="_Next round"
                          Command="{Binding NextRoundCommand}"
                          Visibility="{Binding ShowNextRoundAction, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </MenuItem>
            <MenuItem Header="_Settings">
                <MenuItem Header="Show point _badges"
                          IsCheckable="True"
                          IsChecked="{Binding ShowCardPointBadges, Mode=TwoWay}" />
                <MenuItem Header="Show deck _ribbons"
                          IsCheckable="True"
                          IsChecked="{Binding ShowDeckRibbons, Mode=TwoWay}" />
                <MenuItem Header="_Compact card spacing"
                          IsCheckable="True"
                          IsChecked="{Binding UseCompactCardSpacing, Mode=TwoWay}" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="Open _quick rules help"
                          Click="ShowRulesHelp_Click" />
                <Separator />
                <MenuItem Header="Ctrl+N new match" IsEnabled="False" />
                <MenuItem Header="Ctrl+S save snapshot" IsEnabled="False" />
                <MenuItem Header="Ctrl+O load snapshot" IsEnabled="False" />
                <MenuItem Header="Ctrl+D draw stock" IsEnabled="False" />
            </MenuItem>
        </Menu>

        <Grid Margin="16">
            <Border Background="#FF1F5B47"
                    BorderBrush="#4CFFFFFF"
                    BorderThickness="1"
                    CornerRadius="32" />

            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="240" />
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0"
                        Grid.Column="2"
                        Margin="{StaticResource TopSeatMargin}">
                    <Border.Style>
                        <Style BasedOn="{StaticResource SeatPanelStyle}" TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TopSeatHand}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Margin="10,0,0,6"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="{Binding TopSeatHand.Name}" />
                        <ScrollViewer
                                       HorizontalScrollBarVisibility="Auto"
                                       VerticalScrollBarVisibility="Disabled">
                            <Grid Height="{StaticResource TopSeatCardLaneHeight}">
                                <ItemsControl ItemsSource="{Binding TopSeatHand.Cards}"
                                              VerticalAlignment="Bottom"
                                              ItemContainerStyle="{StaticResource OverlappedHorizontalHandItemStyle}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <StaticResource ResourceKey="DisplayCardTemplate" />
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <Border Grid.Row="0"
                        Grid.RowSpan="3"
                        Grid.Column="0">
                    <Border.Style>
                        <Style BasedOn="{StaticResource SeatPanelStyle}" TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LeftSeatHand}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid Margin="0,0,10,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Margin="0,0,0,6"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="{Binding LeftSeatHand.Name}" />
                        <ScrollViewer Grid.Row="1"
                                        Margin="0,4,0,0"
                                        VerticalScrollBarVisibility="Auto"
                                        HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding LeftSeatHand.Cards}"
                                          Margin="{StaticResource VerticalHandScrollPadding}"
                                          ItemContainerStyle="{StaticResource OverlappedVerticalHandItemStyle}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <StaticResource ResourceKey="DisplayCardTemplate" />
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Grid.Column="2"
                        Padding="18"
                        Background="#1A17212B"
                        BorderBrush="#33FFFFFF"
                        BorderThickness="0"
                        CornerRadius="24"
                        Style="{StaticResource FadeInBorderStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="0.9*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Row="0"
                                    Grid.ColumnSpan="2"
                                    Padding="16"
                                    Background="#1AFFFFFF"
                                    BorderBrush="#1FFFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontSize="26"
                                                   FontWeight="SemiBold"
                                                   Text="CanastaNET table" />
                                        <TextBlock Margin="0,6,0,0"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Text="{Binding TableOverview.RoundNumber, StringFormat=Round {0}}" />
                                        <TextBlock Foreground="{StaticResource MutedTextBrush}"
                                                   Text="{Binding TableOverview.CurrentPlayerName, StringFormat=Current player: {0}}" />
                                        <TextBlock Foreground="{StaticResource MutedTextBrush}"
                                                   Text="{Binding TableOverview.TurnPhaseLabel}" />
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            Margin="18,0,0,0"
                                            Padding="14"
                                            Background="#1F4F9DED"
                                            CornerRadius="14"
                                            Visibility="{Binding ShowNextActionPrompt, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Width="280"
                                                   Text="{Binding NextActionPrompt}"
                                                   TextWrapping="Wrap"
                                                   automation:AutomationProperties.Name="Next action prompt"
                                                   automation:AutomationProperties.HelpText="Suggested next legal action for the current table state." />
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    Margin="0,14,0,0"
                                    Padding="14"
                                    Background="{StaticResource SuccessBrush}"
                                    CornerRadius="14"
                                    Style="{StaticResource FadeInBorderStyle}">
                                <TextBlock Text="{Binding FeedbackMessage, TargetNullValue=Ready for manual play validation.}"
                                           TextWrapping="Wrap"
                                           automation:AutomationProperties.HelpText="Latest feedback from the workspace." />
                            </Border>

                            <StackPanel Grid.Row="2"
                                        Grid.ColumnSpan="2"
                                        Margin="0,14,0,0">
                                <TextBlock FontSize="12"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="Central piles" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="{StaticResource CentralPileSpacerWidth}" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Margin="0,0,0,8"
                                                   FontSize="12"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Text="Stock pile" />
                                        <Grid Width="108"
                                              Height="162">
                                            <Border Margin="16,16,0,0"
                                                    Background="#1EFFFFFF"
                                                    BorderBrush="#2FFFFFFF"
                                                    BorderThickness="1"
                                                    CornerRadius="14" />
                                            <Border Margin="8,8,0,0"
                                                    Background="#2A1C3044"
                                                    BorderBrush="#35FFFFFF"
                                                    BorderThickness="1"
                                                    CornerRadius="14" />
                                            <Border Background="#FFF7FBFF"
                                                    BorderBrush="#FF4F9DED"
                                                    BorderThickness="1.4"
                                                    CornerRadius="14"
                                                    Effect="{StaticResource CardShadowEffect}">
                                                <StackPanel VerticalAlignment="Center"
                                                            HorizontalAlignment="Center">
                                                    <TextBlock HorizontalAlignment="Center"
                                                               FontSize="18"
                                                               FontWeight="Bold"
                                                               Foreground="#FF4F9DED"
                                                               Text="Stock" />
                                                    <TextBlock Margin="0,8,0,0"
                                                               HorizontalAlignment="Center"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="#FF17212B"
                                                               Text="{Binding TableOverview.StockCount, StringFormat={}{0} cards}" />
                                                    <TextBlock Margin="0,6,0,0"
                                                               HorizontalAlignment="Center"
                                                               FontSize="10"
                                                               Foreground="#8A17212B"
                                                               Text="Face-down draw pile"
                                                               TextWrapping="Wrap"
                                                               TextAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                        <TextBlock Margin="0,0,0,8"
                                                   FontSize="12"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Text="Discard pile" />
                                        <ContentPresenter Content="{Binding DiscardPile.TopCardVisual}"
                                                          ContentTemplate="{StaticResource DisplayCardTemplate}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <GroupBox Grid.Row="3"
                                      Grid.Column="0"
                                      Margin="0,14,12,0"
                                      Header="Table actions"
                                      Visibility="{Binding ShowRoundActions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <ComboBox ItemsSource="{Binding AvailableMeldRanks}"
                                              SelectedItem="{Binding SelectedMeldRankName, UpdateSourceTrigger=PropertyChanged}"
                                              Visibility="{Binding ShowMeldAction, Converter={StaticResource BooleanToVisibilityConverter}}"
                                              automation:AutomationProperties.Name="Meld rank selector" />
                                    <WrapPanel>
                                        <Button Command="{Binding DrawStockCommand}"
                                                Content="_Draw stock"
                                                Visibility="{Binding ShowDrawActions, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                automation:AutomationProperties.Name="Draw from the stock pile" />
                                        <Button Command="{Binding DrawDiscardCommand}"
                                                Content="Draw _discard"
                                                Visibility="{Binding ShowDrawActions, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                automation:AutomationProperties.Name="Draw from the discard pile" />
                                        <Button Command="{Binding MeldCommand}"
                                                Content="_Meld selected"
                                                Visibility="{Binding ShowMeldAction, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                automation:AutomationProperties.Name="Meld the selected cards" />
                                        <Button Command="{Binding DiscardCommand}"
                                                Content="D_iscard selected"
                                                Visibility="{Binding ShowDiscardActions, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                automation:AutomationProperties.Name="Discard the selected card" />
                                        <Button Command="{Binding EndTurnCommand}"
                                                Content="_End turn"
                                                Visibility="{Binding ShowDiscardActions, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                automation:AutomationProperties.Name="End the turn by discarding the selected card" />
                                        <Button Command="{Binding NextRoundCommand}"
                                                Content="_Next round"
                                                Visibility="{Binding ShowNextRoundAction, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                automation:AutomationProperties.Name="Start the next round" />
                                    </WrapPanel>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Grid.Row="3"
                                      Grid.Column="1"
                                      Margin="12,14,0,0"
                                      Header="Table state">
                                <StackPanel>
                                    <TextBlock Text="{Binding TableOverview.DiscardTopCard, StringFormat=Discard top: {0}}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,4,0,0"
                                               Text="{Binding DiscardPile.IsFrozen, StringFormat=Discard frozen: {0}}" />
                                    <TextBlock Margin="0,4,0,0"
                                               Text="{Binding TableOverview.CurrentTurnMeldPoints, StringFormat=Meld points this turn: {0}}" />
                                    <TextBlock Margin="0,4,0,0"
                                               Text="{Binding TableOverview.CompletedTurns, StringFormat=Completed turns: {0}}" />
                                    <TextBlock Margin="0,4,0,0"
                                               Text="{Binding TableOverview.ShuffleSeed, StringFormat=Shuffle seed: {0}}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </GroupBox>

                            <Grid Grid.Row="4"
                                  Grid.ColumnSpan="2"
                                  Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="0.9*" />
                                </Grid.ColumnDefinitions>

                                <GroupBox Margin="0,0,12,0" Header="Team melds">
                                    <ItemsControl ItemsSource="{Binding TeamMelds}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,12"
                                                        Padding="12"
                                                        Background="#1435506B"
                                                        CornerRadius="14">
                                                    <StackPanel>
                                                        <TextBlock FontWeight="SemiBold"
                                                                   Text="{Binding TeamIndex, StringFormat=Team {0}}" />
                                                        <TextBlock Margin="0,4,0,0"
                                                                   Foreground="{StaticResource MutedTextBrush}"
                                                                   Text="{Binding Members, StringFormat=Players: {0}}"
                                                                   TextWrapping="Wrap" />
                                                        <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Melds}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Margin="0,0,0,10">
                                                                        <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                                                        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Cards}">
                                                                            <ItemsControl.ItemsPanel>
                                                                                <ItemsPanelTemplate>
                                                                                    <WrapPanel />
                                                                                </ItemsPanelTemplate>
                                                                            </ItemsControl.ItemsPanel>
                                                                            <ItemsControl.ItemTemplate>
                                                                                <StaticResource ResourceKey="DisplayCardTemplate" />
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </GroupBox>

                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <GroupBox Header="Legal action summary">
                                        <ItemsControl ItemsSource="{Binding LegalCommands}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,0,8"
                                                            Padding="12"
                                                            Background="#1C4F9DED"
                                                            CornerRadius="12">
                                                        <StackPanel>
                                                            <TextBlock FontWeight="SemiBold" Text="{Binding CommandText}" />
                                                            <TextBlock Margin="0,6,0,0"
                                                                       Foreground="#DCEBFF"
                                                                       Text="{Binding Description}"
                                                                       TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </GroupBox>

                                    <GroupBox Header="Score summary">
                                        <StackPanel>
                                            <TextBlock Text="{Binding ScoreSummary.WinningScore, StringFormat=Winning score target: {0}}" />
                                            <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding ScoreSummary.TeamScores}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,0,8"
                                                                Padding="12"
                                                                Background="#15FFFFFF"
                                                                CornerRadius="12">
                                                            <TextBlock Text="{Binding SummaryText}" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding ScoreSummary.RoundSummaryLines}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Margin="0,0,0,6"
                                                                   Foreground="{StaticResource MutedTextBrush}"
                                                                   Text="{Binding}"
                                                                   TextWrapping="Wrap" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </GroupBox>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </Border>

                <Border Grid.Row="0"
                        Grid.RowSpan="3"
                        Grid.Column="4">
                    <Border.Style>
                        <Style BasedOn="{StaticResource SeatPanelStyle}" TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RightSeatHand}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid Margin="10,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Margin="0,0,0,6"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="{Binding RightSeatHand.Name}" />
                        <ScrollViewer Grid.Row="1"
                                        Margin="0,4,0,0"
                                        VerticalScrollBarVisibility="Auto"
                                        HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding RightSeatHand.Cards}"
                                          Margin="{StaticResource VerticalHandScrollPadding}"
                                          ItemContainerStyle="{StaticResource OverlappedVerticalHandItemStyle}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <StaticResource ResourceKey="DisplayCardTemplate" />
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Grid.Column="2"
                        Margin="{StaticResource BottomSeatMargin}">
                    <Border.Style>
                        <Style BasedOn="{StaticResource SeatPanelStyle}" TargetType="Border" />
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Margin="10,0,0,6"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="{Binding BottomSeatHand.Name, TargetNullValue=No active hand}" />
                        <ScrollViewer
                                       HorizontalScrollBarVisibility="Auto"
                                       VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding BottomSeatHand.Cards}"
                                          ItemContainerStyle="{StaticResource OverlappedHorizontalHandItemStyle}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <StaticResource ResourceKey="PlayableCardTemplate" />
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
