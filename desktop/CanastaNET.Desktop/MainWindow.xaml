<Window x:Class="CanastaNET.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="CanastaNET Desktop"
        Height="940"
        Width="1480"
        MinHeight="760"
        MinWidth="1240"
        WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding StartMatchCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveMatchCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding LoadMatchCommand}" />
        <KeyBinding Key="D" Modifiers="Control" Command="{Binding DrawStockCommand}" />
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding ApplySetupPresetCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="FadeInBorderStyle" TargetType="Border">
            <Setter Property="Opacity" Value="0" />
            <Style.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0"
                                             To="1"
                                             Duration="0:0:0.18" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <DropShadowEffect x:Key="CardShadowEffect"
                          BlurRadius="16"
                          ShadowDepth="5"
                          Direction="265"
                          Opacity="0.28"
                          Color="#B0000000" />

        <Style x:Key="CardShellStyle" TargetType="Border">
            <Setter Property="Width" Value="148" />
            <Setter Property="Margin" Value="0,0,14,14" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="BorderThickness" Value="1.6" />
            <Setter Property="Effect" Value="{StaticResource CardShadowEffect}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.UseCompactCardSpacing, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Width" Value="134" />
                    <Setter Property="Margin" Value="0,0,10,10" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="DisplayCardTemplate">
            <Border Background="{Binding SurfaceColor}"
                    BorderBrush="{Binding AccentColor}"
                    Style="{StaticResource CardShellStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="8" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="{Binding AccentColor}"
                            CornerRadius="12,12,0,0" />
                    <Grid Grid.Row="1" Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <StackPanel>
                                <TextBlock FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="{Binding AccentColor}"
                                           Text="{Binding RankText}" />
                                <TextBlock Margin="0,-4,0,0"
                                           FontSize="20"
                                           Foreground="{Binding AccentColor}"
                                           Text="{Binding SuitSymbol}" />
                            </StackPanel>
                            <Border HorizontalAlignment="Right"
                                    Padding="8,3"
                                    Background="{Binding AccentColor}"
                                    CornerRadius="10">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.ShowCardPointBadges, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           Text="{Binding PointBadgeText}" />
                            </Border>
                        </Grid>

                        <StackPanel Grid.Row="1"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                            <Border Padding="10,4"
                                    Margin="0,8,0,12"
                                    Background="#12000000"
                                    CornerRadius="9">
                                <TextBlock FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding AccentColor}"
                                           Text="{Binding CardTypeLabel}" />
                            </Border>
                            <TextBlock HorizontalAlignment="Center"
                                       FontSize="52"
                                       Foreground="{Binding AccentColor}"
                                       Text="{Binding SuitSymbol}" />
                            <TextBlock Margin="0,8,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="14"
                                       Foreground="#7A17212B"
                                       Text="{Binding SuitText}" />
                        </StackPanel>

                        <Grid Grid.Row="2">
                            <TextBlock VerticalAlignment="Bottom"
                                       FontSize="11"
                                       Foreground="#9917212B"
                                       Text="{Binding DisplayText}"
                                       TextWrapping="Wrap" />
                            <Border HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Padding="8,3"
                                    Background="#1217212B"
                                    CornerRadius="9">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.ShowDeckRibbons, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="#CC17212B"
                                           Text="{Binding DeckLabel}" />
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PlayableCardTemplate">
            <Border Background="{Binding SurfaceColor}"
                    BorderBrush="{Binding AccentColor}">
                <Border.Style>
                    <Style BasedOn="{StaticResource CardShellStyle}" TargetType="Border">
                        <Setter Property="Background" Value="{Binding SurfaceColor}" />
                        <Setter Property="BorderBrush" Value="{Binding AccentColor}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource ActionBrush}" />
                                <Setter Property="BorderThickness" Value="3" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="8" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="{Binding AccentColor}"
                            CornerRadius="12,12,0,0" />
                    <Grid Grid.Row="1" Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <StackPanel>
                                <TextBlock FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="{Binding AccentColor}"
                                           Text="{Binding RankText}" />
                                <TextBlock Margin="0,-4,0,0"
                                           FontSize="20"
                                           Foreground="{Binding AccentColor}"
                                           Text="{Binding SuitSymbol}" />
                            </StackPanel>
                            <Border HorizontalAlignment="Right"
                                    Padding="8,3"
                                    Background="{Binding AccentColor}"
                                    CornerRadius="10">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.ShowCardPointBadges, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           Text="{Binding PointValue, StringFormat={}{0} pts}" />
                            </Border>
                        </Grid>

                        <StackPanel Grid.Row="1"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                            <CheckBox Margin="0,0,0,10"
                                      HorizontalAlignment="Center"
                                      Content="Ready"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      IsEnabled="{Binding CanSelect}" />
                            <TextBlock HorizontalAlignment="Center"
                                       FontSize="52"
                                       Foreground="{Binding AccentColor}"
                                       Text="{Binding SuitSymbol}" />
                            <TextBlock Margin="0,8,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding AccentColor}"
                                       Text="{Binding CardTypeLabel}" />
                        </StackPanel>

                        <Grid Grid.Row="2">
                            <TextBlock VerticalAlignment="Bottom"
                                       FontSize="11"
                                       Foreground="#9917212B"
                                       Text="{Binding DisplayText}"
                                       TextWrapping="Wrap" />
                            <Border HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Padding="8,3"
                                    Background="#1217212B"
                                    CornerRadius="9">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.ShowDeckRibbons, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="#CC17212B"
                                           Text="{Binding DeckLabel}" />
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top"
              Background="#102B3D52"
              Foreground="{StaticResource PrimaryTextBrush}">
            <MenuItem Header="_File">
                <MenuItem Header="_New match" Command="{Binding StartMatchCommand}" InputGestureText="Ctrl+N" />
                <MenuItem Header="_Save snapshot" Command="{Binding SaveMatchCommand}" InputGestureText="Ctrl+S" />
                <MenuItem Header="_Load snapshot" Command="{Binding LoadMatchCommand}" InputGestureText="Ctrl+O" />
                <Separator />
                <MenuItem Header="Load _recent snapshot" Command="{Binding LoadRecentMatchCommand}" />
            </MenuItem>
            <MenuItem Header="_Navigate">
                <MenuItem Header="_Table overview" Tag="0" Click="NavigateToTab_Click" />
                <MenuItem Header="_Player hands" Tag="1" Click="NavigateToTab_Click" />
                <MenuItem Header="_Melds" Tag="2" Click="NavigateToTab_Click" />
                <MenuItem Header="_Discard pile" Tag="3" Click="NavigateToTab_Click" />
                <MenuItem Header="_Score summary" Tag="4" Click="NavigateToTab_Click" />
                <MenuItem Header="_Rules help" Tag="5" Click="NavigateToTab_Click" />
            </MenuItem>
            <MenuItem Header="_Settings">
                <MenuItem Header="Show point _badges"
                          IsCheckable="True"
                          IsChecked="{Binding ShowCardPointBadges, Mode=TwoWay}" />
                <MenuItem Header="Show deck _ribbons"
                          IsCheckable="True"
                          IsChecked="{Binding ShowDeckRibbons, Mode=TwoWay}" />
                <MenuItem Header="_Compact card spacing"
                          IsCheckable="True"
                          IsChecked="{Binding UseCompactCardSpacing, Mode=TwoWay}" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="Open _rules help" Tag="5" Click="NavigateToTab_Click" />
                <Separator />
                <MenuItem Header="Ctrl+N new match" IsEnabled="False" />
                <MenuItem Header="Ctrl+S save snapshot" IsEnabled="False" />
                <MenuItem Header="Ctrl+O load snapshot" IsEnabled="False" />
                <MenuItem Header="Ctrl+D draw stock" IsEnabled="False" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Top"
                Margin="16,16,16,0"
                Padding="16,14"
                Background="#1AFFFFFF"
                BorderBrush="#1FFFFFFF"
                BorderThickness="1"
                CornerRadius="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="26"
                               FontWeight="SemiBold"
                               Text="CanastaNET" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="18,0,0,0">
                    <TextBlock FontSize="20"
                               FontWeight="SemiBold"
                               Text="{Binding TableOverview.CurrentPlayerName}" />
                    <TextBlock Margin="0,4,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="{Binding TableOverview.TurnPhaseLabel}" />
                </StackPanel>
                <Border Grid.Column="2"
                        Margin="18,0,0,0"
                        Padding="14"
                        Background="#1F4F9DED"
                        CornerRadius="14"
                        Style="{StaticResource FadeInBorderStyle}"
                        Visibility="{Binding ShowNextActionPrompt, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="{Binding NextActionPrompt}"
                                   automation:AutomationProperties.Name="Next action prompt"
                                   TextWrapping="Wrap"
                                   automation:AutomationProperties.HelpText="Suggested next legal action for the current table state." />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Padding="14"
                            Margin="0,0,0,14"
                            Background="{StaticResource SuccessBrush}"
                            CornerRadius="12"
                            Style="{StaticResource FadeInBorderStyle}">
                        <TextBlock Text="{Binding FeedbackMessage, TargetNullValue=Ready for manual play validation.}"
                                   TextWrapping="Wrap"
                                   automation:AutomationProperties.HelpText="Latest feedback from the workspace." />
                    </Border>

                    <GroupBox Header="Round actions"
                              Visibility="{Binding ShowRoundActions, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <WrapPanel>
                            <Button Command="{Binding DrawStockCommand}"
                                    Content="_Draw stock"
                                    Visibility="{Binding ShowDrawActions, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    automation:AutomationProperties.Name="Draw from the stock pile" />
                            <Button Command="{Binding DrawDiscardCommand}"
                                    Content="Draw _discard"
                                    Visibility="{Binding ShowDrawActions, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    automation:AutomationProperties.Name="Draw from the discard pile" />
                            <Button Command="{Binding MeldCommand}"
                                    Content="_Meld selected"
                                    Visibility="{Binding ShowMeldAction, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    automation:AutomationProperties.Name="Meld the selected cards" />
                            <Button Command="{Binding DiscardCommand}"
                                    Content="D_iscard selected"
                                    Visibility="{Binding ShowDiscardActions, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    automation:AutomationProperties.Name="Discard the selected card" />
                            <Button Command="{Binding EndTurnCommand}"
                                    Content="_End turn"
                                    Visibility="{Binding ShowDiscardActions, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    automation:AutomationProperties.Name="End the turn by discarding the selected card" />
                            <Button Command="{Binding NextRoundCommand}"
                                    Content="_Next round"
                                    Visibility="{Binding ShowNextRoundAction, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    automation:AutomationProperties.Name="Start the next round" />
                        </WrapPanel>
                    </GroupBox>

                    <Expander Header="Match setup"
                              IsExpanded="False"
                              automation:AutomationProperties.Name="Match setup section">
                        <StackPanel>
                            <ComboBox Margin="0,10,0,8"
                                      ItemsSource="{Binding SetupPresets}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Name"
                                      SelectedValue="{Binding SelectedSetupPresetName, UpdateSourceTrigger=PropertyChanged}"
                                      automation:AutomationProperties.Name="Setup preset selector" />
                            <Button Margin="0,0,0,12"
                                    Command="{Binding ApplySetupPresetCommand}"
                                    Content="_Apply preset"
                                    automation:AutomationProperties.Name="Apply selected setup preset" />
                            <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Players" />
                            <TextBox Text="{Binding Setup.PlayerNamesCsv, UpdateSourceTrigger=PropertyChanged}"
                                     automation:AutomationProperties.Name="Player names" />

                            <UniformGrid Columns="2" Margin="0,4,0,0">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Teams" />
                                    <TextBox Text="{Binding Setup.TeamCount, UpdateSourceTrigger=PropertyChanged}"
                                             automation:AutomationProperties.Name="Team count" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Dealer" />
                                    <TextBox Text="{Binding Setup.DealerIndex, UpdateSourceTrigger=PropertyChanged}"
                                             automation:AutomationProperties.Name="Dealer index" />
                                </StackPanel>
                            </UniformGrid>

                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Decks" />
                                    <TextBox Text="{Binding Setup.DeckCount, UpdateSourceTrigger=PropertyChanged}"
                                             automation:AutomationProperties.Name="Deck count" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Cards" />
                                    <TextBox Text="{Binding Setup.CardsPerPlayer, UpdateSourceTrigger=PropertyChanged}"
                                             automation:AutomationProperties.Name="Cards per player" />
                                </StackPanel>
                            </UniformGrid>

                            <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Winning score" />
                            <TextBox Text="{Binding Setup.WinningScore, UpdateSourceTrigger=PropertyChanged}"
                                     automation:AutomationProperties.Name="Winning score" />

                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Seed" />
                                    <TextBox Text="{Binding Setup.SeedText, UpdateSourceTrigger=PropertyChanged}"
                                             automation:AutomationProperties.Name="Opening seed" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Next" />
                                    <TextBox Text="{Binding Setup.NextRoundSeedText, UpdateSourceTrigger=PropertyChanged}"
                                             automation:AutomationProperties.Name="Next round seed" />
                                </StackPanel>
                            </UniformGrid>

                            <Button Command="{Binding StartMatchCommand}"
                                    Content="_Start match"
                                    automation:AutomationProperties.Name="Start a new match" />
                        </StackPanel>
                    </Expander>

                    <Expander Header="Snapshots"
                              IsExpanded="False"
                              automation:AutomationProperties.Name="Snapshots section">
                        <StackPanel>
                            <ComboBox Margin="0,0,0,10"
                                      ItemsSource="{Binding AvailableMeldRanks}"
                                      SelectedItem="{Binding SelectedMeldRankName, UpdateSourceTrigger=PropertyChanged}"
                                      automation:AutomationProperties.Name="Meld rank selector"
                                      Visibility="{Binding ShowMeldAction, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBox Text="{Binding MatchFilePath, UpdateSourceTrigger=PropertyChanged}"
                                     automation:AutomationProperties.Name="Match snapshot path" />
                            <WrapPanel>
                                <Button Command="{Binding SaveMatchCommand}"
                                        Content="_Save match"
                                        automation:AutomationProperties.Name="Save the current match snapshot" />
                                <Button Command="{Binding LoadMatchCommand}"
                                        Content="_Load match"
                                        automation:AutomationProperties.Name="Load a match snapshot from disk" />
                            </WrapPanel>
                            <ComboBox Margin="0,10,0,8"
                                      ItemsSource="{Binding RecentMatches}"
                                      DisplayMemberPath="DisplayText"
                                      SelectedValuePath="Path"
                                      SelectedValue="{Binding SelectedRecentMatchPath, UpdateSourceTrigger=PropertyChanged}"
                                      automation:AutomationProperties.Name="Recent match history" />
                            <Button Command="{Binding LoadRecentMatchCommand}"
                                    Content="Load _recent match"
                                    automation:AutomationProperties.Name="Load selected recent match" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <TabControl x:Name="WorkspaceTabs"
                        Grid.Column="2"
                        SelectedIndex="1"
                        Background="#162434"
                        BorderThickness="0">
                <TabItem Header="Table overview">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="18">
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.8*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Padding="18"
                                        Margin="0,0,16,0"
                                        Background="#112F5D50"
                                        BorderBrush="#334F9DED"
                                        BorderThickness="1"
                                        CornerRadius="18">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock FontSize="24" FontWeight="SemiBold" Text="Round overview" />
                                            <TextBlock Margin="0,6,0,0"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       Text="A quick read on the active table, tuned for faster navigation between hands, melds, and discard flow."
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="18,0,0,0">
                                            <TextBlock Text="{Binding TableOverview.RoundNumber, StringFormat=Round {0}}" />
                                            <TextBlock Text="{Binding TableOverview.CurrentPlayerName, StringFormat=Current player: {0}}" />
                                            <TextBlock Text="{Binding TableOverview.CompletedTurns, StringFormat=Completed turns: {0}}" />
                                            <TextBlock Text="{Binding TableOverview.CurrentTurnMeldPoints, StringFormat=Meld points this turn: {0}}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="18,0,0,0">
                                            <TextBlock Text="{Binding TableOverview.StockCount, StringFormat=Stock: {0} cards}" />
                                            <TextBlock Text="{Binding DiscardPile.IsFrozen, StringFormat=Discard frozen: {0}}" />
                                            <TextBlock Text="{Binding TableOverview.ShuffleSeed, StringFormat=Shuffle seed: {0}}" />
                                            <TextBlock Text="{Binding TableOverview.DiscardTopCard, StringFormat=Discard top: {0}}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Grid.Column="1"
                                        Padding="18"
                                        Background="#15FFFFFF"
                                        BorderBrush="#1FFFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="18">
                                    <StackPanel>
                                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Discard spotlight" />
                                        <TextBlock Margin="0,6,0,12"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Text="The top discard now uses the same card artwork as hands and melds for instant recognition."
                                                   TextWrapping="Wrap" />
                                        <ContentPresenter Content="{Binding DiscardPile.TopCardVisual}"
                                                          ContentTemplate="{StaticResource DisplayCardTemplate}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.15*" />
                                    <ColumnDefinition Width="1.35*" />
                                </Grid.ColumnDefinitions>
                                <GroupBox Header="Legal action summary">
                                    <ItemsControl ItemsSource="{Binding LegalCommands}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,10,10"
                                                        Padding="12"
                                                        Width="240"
                                                        Background="#1C4F9DED"
                                                        CornerRadius="12">
                                                    <StackPanel>
                                                        <TextBlock FontWeight="SemiBold" Text="{Binding CommandText}" />
                                                        <TextBlock Margin="0,6,0,0"
                                                                   Foreground="#DCEBFF"
                                                                   Text="{Binding Description}"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </GroupBox>

                                <GroupBox Grid.Column="1" Header="Round completion summary">
                                    <StackPanel>
                                        <TextBlock Foreground="{StaticResource MutedTextBrush}"
                                                   Text="{Binding TableOverview.RoundMessage, TargetNullValue=The round is still in progress.}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Margin="0,12,0,0"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Text="Use the Navigate menu to jump directly to hands, melds, or rules without leaving the current match context."
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </GroupBox>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Player hands">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="18">
                            <Border Padding="20"
                                    Margin="0,0,0,16"
                                    Background="#0EFFFFFF"
                                    BorderBrush="#1FFFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="18">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding CurrentPlayerHand.Name, TargetNullValue=No active hand}" />
                                        <TextBlock Margin="0,8,0,0"
                                                   FontSize="18"
                                                    FontWeight="SemiBold"
                                                    Text="{Binding CurrentPlayerHand.CardCount, StringFormat={}{0} cards}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <GroupBox Header="Current player hand">
                                <ItemsControl ItemsSource="{Binding CurrentPlayerHand.Cards}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <StaticResource ResourceKey="PlayableCardTemplate" />
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </GroupBox>

                            <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding WaitingPlayerHands}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <GroupBox Header="{Binding Header}">
                                            <StackPanel>
                                                <TextBlock Margin="0,0,0,10"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           Text="{Binding CardCount, StringFormat=Cards waiting off-turn: {0}}" />
                                                <ItemsControl ItemsSource="{Binding Cards}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <StaticResource ResourceKey="PlayableCardTemplate" />
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </GroupBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Melds">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl Margin="18" ItemsSource="{Binding TeamMelds}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <GroupBox Header="{Binding TeamIndex, StringFormat=Team {0}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Members, StringFormat=Players: {0}}" />
                                            <TextBlock Margin="0,2,0,10" Text="{Binding StartingScore, StringFormat=Starting score: {0}}" />
                                            <ItemsControl ItemsSource="{Binding Melds}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,0,12"
                                                                Padding="14"
                                                                Background="#1435506B"
                                                                CornerRadius="14">
                                                            <StackPanel>
                                                                <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                                                <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Cards}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <WrapPanel />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <StaticResource ResourceKey="DisplayCardTemplate" />
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </GroupBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Discard pile">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="18">
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <GroupBox Header="Top discard card">
                                    <StackPanel>
                                        <ContentPresenter Content="{Binding DiscardPile.TopCardVisual}"
                                                          ContentTemplate="{StaticResource DisplayCardTemplate}" />
                                        <TextBlock Margin="0,8,0,0"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Text="{Binding DiscardPile.IsFrozen, StringFormat=Frozen pile: {0}}" />
                                    </StackPanel>
                                </GroupBox>
                                <GroupBox Grid.Column="1" Header="Pile order (top first)">
                                    <ItemsControl ItemsSource="{Binding DiscardPile.Cards}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <StaticResource ResourceKey="DisplayCardTemplate" />
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </GroupBox>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Score summary">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="18">
                            <GroupBox Header="Match totals">
                                <StackPanel>
                                    <TextBlock Text="{Binding ScoreSummary.WinningScore, StringFormat=Winning score target: {0}}" />
                                    <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding ScoreSummary.TeamScores}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,8"
                                                        Padding="12"
                                                        Background="#151FFFFFF"
                                                        CornerRadius="12">
                                                    <TextBlock Text="{Binding SummaryText}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Completed-round summary">
                                <ItemsControl ItemsSource="{Binding ScoreSummary.RoundSummaryLines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,8"
                                                    Padding="12"
                                                    Background="#1235506B"
                                                    CornerRadius="12">
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Rules help">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="18">
                            <TextBlock FontSize="24" FontWeight="SemiBold" Text="Quick rules help" />
                            <TextBlock Margin="0,6,0,16"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="Use the richer navigation menu to keep this help nearby while you move between the overview, hands, melds, and discard pile."
                                       TextWrapping="Wrap" />

                            <ItemsControl ItemsSource="{Binding RulesHelpLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,10"
                                                Padding="14"
                                                Background="#1235506B"
                                                CornerRadius="14">
                                            <TextBlock Text="{Binding StringFormat=• {0}}" TextWrapping="Wrap" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
